# ============================================================================
# .env.example — Copy this file to .env and fill in your real values
# ============================================================================

# 1. SEPOLIA RPC URL
#    Get a free one from:
#      • https://www.infura.io   → create a project → copy the Sepolia endpoint
#      • https://www.alchemy.com → create an app    → copy the Sepolia endpoint
#    Example:  https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# 2. PRIVATE KEY of the wallet that will deploy the contract.
#    Export it from MetaMask: Account Details → "Show private key".
#    ⚠️  NEVER commit the real .env file to Git!
#    ⚠️  Make sure this wallet has Sepolia ETH for gas.
#        Faucets:
#          • https://sepoliafaucet.com
#          • https://www.infura.io/faucet/sepolia
#          • https://faucet.quicknode.com/ethereum/sepolia
#          • https://cloud.google.com/application/web3/faucet/ethereum/sepolia
PRIVATE_KEY=your_wallet_private_key_here_without_0x_prefix
