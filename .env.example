# Ethereum Sepolia Testnet RPC Provider
# Get from Infura (https://www.infura.io/) or Alchemy (https://www.alchemy.com/)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Your wallet's private key (without the 0x prefix)
# NEVER commit .env to Git — it's in .gitignore for security
# Get from MetaMask: Account Details → Show private key
PRIVATE_KEY=your_private_key_here_64_hex_characters
